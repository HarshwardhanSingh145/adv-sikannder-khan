{
  "entities": {
    "CaseRecord": {
      "title": "CaseRecord",
      "description": "Legal case record managed by Advocate Sikandar Khan",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "caseNumber": { "type": "string", "maxLength": 128 },
        "caseTitle": { "type": "string", "maxLength": 256 },
        "clientName": { "type": "string", "maxLength": 256 },
        "opponentName": { "type": "string", "maxLength": 256 },
        "caseType": { "type": "string", "maxLength": 128 },
        "courtName": { "type": "string", "maxLength": 256 },
        "courtRoomNumber": { "type": "string", "maxLength": 64 },
        "filingDate": { "type": "string", "maxLength": 64 },
        "priority": { "type": "string", "maxLength": 32 },
        "currentStage": { "type": "string", "maxLength": 128 },
        "currentStatus": { "type": "string", "maxLength": 64 },
        "isStarred": { "type": "boolean" },
        "isPinned": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "caseNumber", "caseTitle", "clientName"]
    },
    "ClientProfile": {
      "title": "ClientProfile",
      "description": "Client profile details",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 256 },
        "phone": { "type": "string", "maxLength": 64 },
        "email": { "type": "string", "maxLength": 256 },
        "address": { "type": "string", "maxLength": 512 },
        "notes": { "type": "string", "maxLength": 1024 },
        "totalCases": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "name", "phone"]
    },
    "NewsItem": {
      "title": "NewsItem",
      "description": "Legal news and court announcements published on the portal",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "content": { "type": "string", "maxLength": 4096 },
        "category": { "type": "string", "maxLength": 128 },
        "publishedAt": { "type": "string", "maxLength": 128 },
        "isPinned": { "type": "boolean" },
        "isAutoGenerated": { "type": "boolean" },
        "caseNumber": { "type": "string", "maxLength": 128 },
        "courtName": { "type": "string", "maxLength": 256 }
      },
      "required": ["id", "title", "content", "category"]
    },
    "Consultation": {
      "title": "Consultation",
      "description": "Client consultation requests and leads submitted via form",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 256 },
        "phone": { "type": "string", "maxLength": 64 },
        "email": { "type": "string", "maxLength": 256 },
        "subject": { "type": "string", "maxLength": 256 },
        "message": { "type": "string", "maxLength": 2048 },
        "status": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "name", "phone"]
    },
    "FeePaymentRecord": {
      "title": "FeePaymentRecord",
      "description": "Fee payment records and ledger for legal services",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "caseId": { "type": "string", "maxLength": 128 },
        "caseNumber": { "type": "string", "maxLength": 128 },
        "clientName": { "type": "string", "maxLength": 256 },
        "totalFee": { "type": "number" },
        "paidAmount": { "type": "number" },
        "pendingAmount": { "type": "number" },
        "lastPaymentDate": { "type": "string", "maxLength": 128 },
        "dueDate": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "caseId", "clientName", "totalFee"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "System security and administrative audit activity logs",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "action": { "type": "string", "maxLength": 128 },
        "details": { "type": "string", "maxLength": 1024 },
        "ipAddress": { "type": "string", "maxLength": 128 },
        "device": { "type": "string", "maxLength": 128 },
        "timestamp": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "action", "timestamp"]
    }
  },
  "firestore": {
    "/cases/{caseId}": {
      "schema": "CaseRecord",
      "description": "Main legal cases collection"
    },
    "/clients/{clientId}": {
      "schema": "ClientProfile",
      "description": "Client directory collection"
    },
    "/news/{newsId}": {
      "schema": "NewsItem",
      "description": "Public news portal articles and court cause list announcements"
    },
    "/consultations/{consultationId}": {
      "schema": "Consultation",
      "description": "Incoming client consultation leads"
    },
    "/payments/{paymentId}": {
      "schema": "FeePaymentRecord",
      "description": "Fee ledger payments collection"
    },
    "/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "Administrative security audit logs"
    }
  }
}
