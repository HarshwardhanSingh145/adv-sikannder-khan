rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Advocate Sikandar Khan Chamber Workspace (PIN-gated prototype;
// client-side Firebase Auth sign-in is not yet enabled).
//
// Collection: cases/{caseId}
// Document ID: caseId (alphanumeric, underscores, hyphens; 1-128 chars)
// Fields:
//   - id: string (required, matches caseId, 1-128 chars, immutable)
//   - partyName: string (optional, 0-300 chars)
//   - clientName: string (required, 0-300 chars)
//   - clientMobile: string (optional, 0-50 chars)
//   - caseTitle: string (required, 0-500 chars)
//   - caseNumber: string (required, 0-200 chars)
//   - firNumber: string (optional, 0-200 chars)
//   - courtName: string (required, 0-300 chars)
//   - courtRoomNumber: string (optional, 0-150 chars)
//   - caseType: string (optional, 0-100 chars)
//   - caseBackground: string (optional, 0-200 chars)
//   - act: string (optional, 0-200 chars)
//   - opponentName: string (optional, 0-300 chars)
//   - advocateName: string (optional, 0-200 chars)
//   - filingDate: string (optional, 0-64 chars)
//   - currentStage: string (optional, 0-150 chars)
//   - isCustomStage: bool (optional)
//   - currentStatus: string (optional, enum: Active|Pending|Stay Granted|Disposed|Won)
//   - priority: string (optional, enum: high|medium|normal)
//   - caseTags: list (optional, max 50 items)
//   - isStarred: bool (optional)
//   - isPinned: bool (optional)
//   - notes: string (optional, 0-20000 chars)
//   - caseNotes: list (optional, max 200 items)
//   - attachments: list (optional, max 100 items)
//   - hearings: list (optional, max 500 items)
//   - documents: list (optional, max 200 items)
//   - evidence: list (optional, max 200 items)
//   - stickyNotes: list (optional, max 200 items)
//   - createdAt: string (optional, 0-64 chars)
//   - updatedAt: string (optional, 0-64 chars)
//
// Collection: trashedCases/{caseId}
// Document ID: caseId (alphanumeric, underscores, hyphens; 1-128 chars)
// Fields:
//   - All CaseRecord fields above, plus:
//   - deletedAt: string (required, 1-64 chars) - ISO timestamp when moved to Recycle Bin
//
// Collection: clients/{clientId}
// Document ID: clientId (alphanumeric, underscores, hyphens; 1-128 chars)
// Fields:
//   - id: string (required, matches clientId, 1-128 chars, immutable)
//   - name: string (required, 0-200 chars)
//   - mobile: string (optional, 0-40 chars)
//   - whatsapp: string (optional, 0-40 chars)
//   - email: string (optional, 0-200 chars)
//   - address: string (optional, 0-1000 chars)
//   - aadhaar: string (optional, 0-50 chars)
//   - pan: string (optional, 0-50 chars)
//   - photoUrl: string (optional, 0-500000 chars)
//   - linkedCaseIds: list (optional, max 200 items)
//   - paymentStatus: string (optional, enum: Paid|Pending|Overdue)
//   - totalFees: number (optional, 0..1000000000)
//   - paidAmount: number (optional, 0..1000000000)
//   - createdAt: string (optional, 0-64 chars)
//
// Collection: news/{newsId}
// Document ID: newsId (alphanumeric, underscores, hyphens; 1-128 chars)
// Fields:
//   - id: string (required, matches newsId, 1-128 chars, immutable)
//   - title: string (required, 1-300 chars)
//   - content: string (required, 1-10000 chars)
//   - category: string (required, enum of supported legal portal categories)
//   - publishedAt: string (required, 1-64 chars)
//   - isPinned: bool (optional)
//   - isAutoGenerated: bool (optional)
//   - caseNumber: string (optional, 0-200 chars)
//   - courtName: string (optional, 0-300 chars)
//
// Collection: payments/{paymentId}
// Document ID: paymentId (alphanumeric, underscores, hyphens; 1-128 chars)
// Fields:
//   - id: string (required, matches paymentId, 1-128 chars, immutable)
//   - caseId: string (required, 1-128 chars)
//   - caseNumber: string (optional, 0-200 chars)
//   - clientName: string (optional, 0-300 chars)
//   - totalFee: number (required, 0..1000000000)
//   - paidAmount: number (required, 0..1000000000)
//   - pendingAmount: number (optional, 0..1000000000)
//   - lastPaymentDate: string (optional, 0-64 chars)
//   - dueDate: string (optional, 0-64 chars)
//   - history: list (optional, max 500 items)
//
// Collection: auditLogs/{logId}
// Document ID: logId (alphanumeric, underscores, hyphens; 1-128 chars)
// Fields:
//   - id: string (required, matches logId, 1-128 chars, immutable)
//   - action: string (required, 1-128 chars)
//   - details: string (required, 0-2000 chars)
//   - ipAddress: string (optional, 0-128 chars)
//   - device: string (optional, 0-256 chars)
//   - timestamp: string (required, 1-64 chars)
//
// Collection: consultations/{consultationId}
// Document ID: consultationId (alphanumeric, underscores, hyphens; 1-128 chars)
// Fields:
//   - id: string (required, matches consultationId, 1-128 chars, immutable)
//   - name: string (required, 1-200 chars)
//   - phone: string (required, 1-40 chars)
//   - email: string (optional, 0-200 chars)
//   - subject: string (optional, 0-300 chars)
//   - message: string (optional, 0-5000 chars)
//   - status: string (required, 1-64 chars)
//   - createdAt: string (required, 1-64 chars)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Auth helpers (ready for hardening once Firebase Auth is enabled)
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        (isAuthenticated() && request.resource.data.uid == request.auth.uid);
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    // Document ID format validation
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 &&
        id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Schema & field helpers
    function hasRequiredFields(data, fields) {
      return data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(data, fields) {
      return data.keys().hasOnly(fields);
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // Type & size bound helpers
    function isBoundedString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isOptionalString(data, field, maxLen) {
      return !(field in data) || data[field] == null ||
        (data[field] is string && data[field].size() <= maxLen);
    }

    function isOptionalBool(data, field) {
      return !(field in data) || data[field] == null || data[field] is bool;
    }

    function isOptionalList(data, field, maxSize) {
      return !(field in data) || data[field] == null ||
        (data[field] is list && data[field].size() <= maxSize);
    }

    function isOptionalNonNegativeNumber(data, field, maxVal) {
      return !(field in data) || data[field] == null ||
        (data[field] is number && data[field] >= 0 && data[field] <= maxVal);
    }

    // ===============================================================
    // Domain Validators (Used in BOTH create and update)
    // ===============================================================

    function hasValidCaseCoreFields(data, docId) {
      return hasRequiredFields(data, ['id', 'clientName', 'caseTitle', 'caseNumber', 'courtName']) &&
        isValidId(docId) &&
        data.id == docId &&
        isBoundedString(data.clientName, 0, 300) &&
        isBoundedString(data.caseTitle, 0, 500) &&
        isBoundedString(data.caseNumber, 0, 200) &&
        isBoundedString(data.courtName, 0, 300) &&
        isOptionalString(data, 'partyName', 300) &&
        isOptionalString(data, 'clientMobile', 50) &&
        isOptionalString(data, 'firNumber', 200) &&
        isOptionalString(data, 'courtRoomNumber', 150) &&
        isOptionalString(data, 'caseType', 100) &&
        isOptionalString(data, 'caseBackground', 200) &&
        isOptionalString(data, 'act', 200) &&
        isOptionalString(data, 'opponentName', 300) &&
        isOptionalString(data, 'advocateName', 200) &&
        isOptionalString(data, 'filingDate', 64) &&
        isOptionalString(data, 'currentStage', 150) &&
        isOptionalBool(data, 'isCustomStage') &&
        (!('currentStatus' in data) || data.currentStatus == null ||
          data.currentStatus in ['Active', 'Pending', 'Stay Granted', 'Disposed', 'Won']) &&
        (!('priority' in data) || data.priority == null ||
          data.priority in ['high', 'medium', 'normal']) &&
        isOptionalList(data, 'caseTags', 50) &&
        isOptionalBool(data, 'isStarred') &&
        isOptionalBool(data, 'isPinned') &&
        isOptionalString(data, 'notes', 20000) &&
        isOptionalList(data, 'caseNotes', 200) &&
        isOptionalList(data, 'attachments', 100) &&
        isOptionalList(data, 'hearings', 500) &&
        isOptionalList(data, 'documents', 200) &&
        isOptionalList(data, 'evidence', 200) &&
        isOptionalList(data, 'stickyNotes', 200) &&
        isOptionalString(data, 'createdAt', 64) &&
        isOptionalString(data, 'updatedAt', 64);
    }

    function isValidCase(data, caseId) {
      let allowed = [
        'id', 'partyName', 'clientName', 'clientMobile', 'caseTitle', 'caseNumber',
        'firNumber', 'courtName', 'courtRoomNumber', 'caseType', 'caseBackground',
        'act', 'opponentName', 'advocateName', 'filingDate', 'currentStage',
        'isCustomStage', 'currentStatus', 'priority', 'caseTags', 'isStarred',
        'isPinned', 'notes', 'caseNotes', 'attachments', 'hearings', 'documents',
        'evidence', 'stickyNotes', 'createdAt', 'updatedAt'
      ];
      return hasOnlyAllowedFields(data, allowed) &&
        hasValidCaseCoreFields(data, caseId);
    }

    function isValidTrashedCase(data, caseId) {
      let allowed = [
        'id', 'partyName', 'clientName', 'clientMobile', 'caseTitle', 'caseNumber',
        'firNumber', 'courtName', 'courtRoomNumber', 'caseType', 'caseBackground',
        'act', 'opponentName', 'advocateName', 'filingDate', 'currentStage',
        'isCustomStage', 'currentStatus', 'priority', 'caseTags', 'isStarred',
        'isPinned', 'notes', 'caseNotes', 'attachments', 'hearings', 'documents',
        'evidence', 'stickyNotes', 'createdAt', 'updatedAt', 'deletedAt'
      ];
      return hasOnlyAllowedFields(data, allowed) &&
        hasValidCaseCoreFields(data, caseId) &&
        ('deletedAt' in data) &&
        isBoundedString(data.deletedAt, 1, 64);
    }

    function isValidClient(data, clientId) {
      let allowed = [
        'id', 'name', 'mobile', 'whatsapp', 'email', 'address', 'aadhaar', 'pan',
        'photoUrl', 'linkedCaseIds', 'paymentStatus', 'totalFees', 'paidAmount', 'createdAt'
      ];
      return hasOnlyAllowedFields(data, allowed) &&
        hasRequiredFields(data, ['id', 'name']) &&
        isValidId(clientId) &&
        data.id == clientId &&
        isBoundedString(data.name, 0, 200) &&
        isOptionalString(data, 'mobile', 40) &&
        isOptionalString(data, 'whatsapp', 40) &&
        isOptionalString(data, 'email', 200) &&
        isOptionalString(data, 'address', 1000) &&
        isOptionalString(data, 'aadhaar', 50) &&
        isOptionalString(data, 'pan', 50) &&
        isOptionalString(data, 'photoUrl', 500000) &&
        isOptionalList(data, 'linkedCaseIds', 200) &&
        (!('paymentStatus' in data) || data.paymentStatus == null ||
          data.paymentStatus in ['Paid', 'Pending', 'Overdue']) &&
        isOptionalNonNegativeNumber(data, 'totalFees', 1000000000) &&
        isOptionalNonNegativeNumber(data, 'paidAmount', 1000000000) &&
        isOptionalString(data, 'createdAt', 64);
    }

    function isValidNews(data, newsId) {
      let allowed = [
        'id', 'title', 'content', 'category', 'publishedAt',
        'isPinned', 'isAutoGenerated', 'caseNumber', 'courtName'
      ];
      let validCategories = [
        "Today's Hearing",
        "Tomorrow's Hearing",
        "Court Order",
        "Important Notice",
        "Urgent Case",
        "Court Holiday",
        "Meeting Reminder",
        "General Announcement"
      ];
      return hasOnlyAllowedFields(data, allowed) &&
        hasRequiredFields(data, ['id', 'title', 'content', 'category', 'publishedAt']) &&
        isValidId(newsId) &&
        data.id == newsId &&
        isBoundedString(data.title, 1, 300) &&
        isBoundedString(data.content, 1, 10000) &&
        data.category in validCategories &&
        isBoundedString(data.publishedAt, 1, 64) &&
        isOptionalBool(data, 'isPinned') &&
        isOptionalBool(data, 'isAutoGenerated') &&
        isOptionalString(data, 'caseNumber', 200) &&
        isOptionalString(data, 'courtName', 300);
    }

    function isValidPayment(data, paymentId) {
      let allowed = [
        'id', 'caseId', 'caseNumber', 'clientName', 'totalFee',
        'paidAmount', 'pendingAmount', 'lastPaymentDate', 'dueDate', 'history'
      ];
      return hasOnlyAllowedFields(data, allowed) &&
        hasRequiredFields(data, ['id', 'caseId', 'totalFee', 'paidAmount']) &&
        isValidId(paymentId) &&
        data.id == paymentId &&
        isBoundedString(data.caseId, 1, 128) &&
        isOptionalString(data, 'caseNumber', 200) &&
        isOptionalString(data, 'clientName', 300) &&
        data.totalFee is number && data.totalFee >= 0 && data.totalFee <= 1000000000 &&
        data.paidAmount is number && data.paidAmount >= 0 && data.paidAmount <= 1000000000 &&
        isOptionalNonNegativeNumber(data, 'pendingAmount', 1000000000) &&
        isOptionalString(data, 'lastPaymentDate', 64) &&
        isOptionalString(data, 'dueDate', 64) &&
        isOptionalList(data, 'history', 500);
    }

    function isValidAuditLog(data, logId) {
      let allowed = ['id', 'action', 'details', 'ipAddress', 'device', 'timestamp'];
      return hasOnlyAllowedFields(data, allowed) &&
        hasRequiredFields(data, ['id', 'action', 'details', 'timestamp']) &&
        isValidId(logId) &&
        data.id == logId &&
        isBoundedString(data.action, 1, 128) &&
        isBoundedString(data.details, 0, 2000) &&
        isOptionalString(data, 'ipAddress', 128) &&
        isOptionalString(data, 'device', 256) &&
        isBoundedString(data.timestamp, 1, 64);
    }

    function isValidConsultation(data, consultationId) {
      let allowed = ['id', 'name', 'phone', 'email', 'subject', 'message', 'status', 'createdAt'];
      return hasOnlyAllowedFields(data, allowed) &&
        hasRequiredFields(data, ['id', 'name', 'phone', 'status', 'createdAt']) &&
        isValidId(consultationId) &&
        data.id == consultationId &&
        isBoundedString(data.name, 1, 200) &&
        isBoundedString(data.phone, 1, 40) &&
        isOptionalString(data, 'email', 200) &&
        isOptionalString(data, 'subject', 300) &&
        isOptionalString(data, 'message', 5000) &&
        isBoundedString(data.status, 1, 64) &&
        isBoundedString(data.createdAt, 1, 64);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Cases collection: Advocate chamber active case records
    match /cases/{caseId} {
      allow read: if true;
      allow create: if isValidCase(request.resource.data, caseId);
      allow update: if isValidCase(request.resource.data, caseId) &&
        areImmutableFieldsUnchanged(['id']);
      allow delete: if isValidId(caseId);
    }

    // Trashed cases collection: Recycle Bin for soft-deleted cases
    match /trashedCases/{caseId} {
      allow read: if true;
      allow create: if isValidTrashedCase(request.resource.data, caseId);
      allow update: if isValidTrashedCase(request.resource.data, caseId) &&
        areImmutableFieldsUnchanged(['id']);
      allow delete: if isValidId(caseId);
    }

    // Clients collection: Advocate client directory
    match /clients/{clientId} {
      allow read: if true;
      allow create: if isValidClient(request.resource.data, clientId);
      allow update: if isValidClient(request.resource.data, clientId) &&
        areImmutableFieldsUnchanged(['id']);
      allow delete: if isValidId(clientId);
    }

    // News portal collection: Legal updates & hearing announcements
    match /news/{newsId} {
      allow read: if true;
      allow create: if isValidNews(request.resource.data, newsId);
      allow update: if isValidNews(request.resource.data, newsId) &&
        areImmutableFieldsUnchanged(['id']);
      allow delete: if isValidId(newsId);
    }

    // Fee payment records: Chamber fee ledger
    match /payments/{paymentId} {
      allow read: if true;
      allow create: if isValidPayment(request.resource.data, paymentId);
      allow update: if isValidPayment(request.resource.data, paymentId) &&
        areImmutableFieldsUnchanged(['id']);
      allow delete: if isValidId(paymentId);
    }

    // Audit logs: Security & activity audit trail
    match /auditLogs/{logId} {
      allow read: if true;
      allow create: if isValidAuditLog(request.resource.data, logId);
      allow update: if isValidAuditLog(request.resource.data, logId) &&
        areImmutableFieldsUnchanged(['id']);
      allow delete: if isValidId(logId);
    }

    // Consultation requests: Public booking form & admin management
    match /consultations/{consultationId} {
      allow read: if true;
      allow create: if isValidConsultation(request.resource.data, consultationId);
      allow update: if isValidConsultation(request.resource.data, consultationId) &&
        areImmutableFieldsUnchanged(['id']);
      allow delete: if isValidId(consultationId);
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
